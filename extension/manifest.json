{
  "manifest_version": 3,
  "name": "KOL 本地助手",
  "description": "本地整理 TikTok 达人资料、品牌关键词视频与表格输出。",
  "version": "0.1.19",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "alarms",
    "unlimitedStorage",
    "clipboardWrite"
  ],
  "optional_host_permissions": [
    "https://*.tiktok.com/*",
    "https://*.instagram.com/*",
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开 KOL 本地助手"
  },
  "options_ui": {
    "page": "app.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
